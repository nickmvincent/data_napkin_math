---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <nav class="navbar">
      <a class="navbar-brand" href="#">Data Napkin Math</a>
      <ul class="navbar-nav">
        <li><a class="nav-link" href="#napkinMath">Scenarios</a></li>
        <li><a class="nav-link" href="#aboutContent">About</a></li>
        <li><a class="nav-link" href="https://github.com/nickmvincent/data_napkin_math" target="_blank">GitHub</a></li>
      </ul>
    </nav>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
